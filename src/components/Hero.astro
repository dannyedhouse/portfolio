---
import { Image } from 'astro:assets';
import vhsMark from '../assets/VHS.webp';
---

<section id="home">
  <div class="arrow" aria-hidden="true"></div>
  <h1>
    <span class="hi">Hi there.</span>
    <span class="title">Danny Edhouse</span>
  </h1>
  <div class="foot">
    <div class="badge">
      <Image src={vhsMark} alt="VHS" class="vhs" height={42} densities={[1, 2]} />
      <span class="meta">HQ<br />Supercolor</span>
    </div>
  </div>
</section>

<style>
  #home {
    position: relative;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: clamp(80px, 12vh, 150px) clamp(26px, 4vw, 54px) clamp(18px, 3vh, 34px)
      clamp(34px, 5vw, 78px);
  }

  .arrow {
    position: absolute;
    top: 50%;
    right: 0;
    transform: translateY(-50%);
    z-index: 1;
    pointer-events: none;
    width: clamp(52px, 7vw, 110px);
    height: clamp(104px, 14vw, 220px);
    background: var(--ink);
    clip-path: polygon(100% 0, 100% 100%, 0 50%);
  }

  h1 {
    position: relative;
    z-index: 1;
    margin: 0;
    max-width: 16ch;
    font-family: var(--display);
    font-size: clamp(38px, min(9vw, 12vh), 132px);
    line-height: 0.88;
    letter-spacing: -0.015em;
    text-transform: uppercase;
    text-shadow:
      3px 0 color-mix(in srgb, var(--mg) 60%, transparent),
      -3px 0 color-mix(in srgb, var(--cy) 60%, transparent);
    animation: jitter 8s steps(1) infinite;
  }

  .hi {
    display: block;
    font-size: 0.52em;
    letter-spacing: 0.01em;
    line-height: 1;
  }

  .title {
    display: block;
  }

  .foot {
    position: relative;
    z-index: 1;
    margin-top: auto;
    padding-top: clamp(18px, 3.2vh, 50px);
    display: flex;
    align-items: flex-end;
    font-size: 12px;
    letter-spacing: 0.18em;
    color: var(--mid);
  }

  .badge {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .vhs {
    display: block;
    width: auto;
    height: 42px;
  }

  .meta {
    line-height: 1.6;
    color: var(--mid);
  }

  @keyframes jitter {
    0%,
    90%,
    100% {
      transform: translate(0, 0);
    }
    92% {
      transform: translate(-2px, 0);
    }
    94% {
      transform: translate(2px, 1px);
    }
    96% {
      transform: translate(-1px, -1px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    h1 {
      animation: none;
    }
  }
</style>
