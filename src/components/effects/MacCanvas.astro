<div class="mac" data-mac aria-hidden="true"></div>

<script>
  const host = document.querySelector<HTMLDivElement>('[data-mac]')

  if (host) {
    const ink = (a: number) => `rgba(20,18,16,${a})`
    const glass = (a: number) => `rgba(236,231,220,${a})`
    const mono = '"Share Tech Mono", ui-monospace, monospace'
    const lerp = (a: number, b: number, n: number) => a + (b - a) * n

    const term = ['> load portfolio', '', 'DLE-01', 'SOFTWARE ENGINEER', '', '> ready']
    const flat = term.join('\n')
    const cols = Math.max(...term.map((l) => l.length))
    const cps = 4.5

    const desk = ['Projects', 'Terminal', 'Pinball'] as const
    const arrow = [
      [0, 0],
      [0, 1],
      [0.26, 0.74],
      [0.43, 1.13],
      [0.58, 1.06],
      [0.41, 0.69],
      [0.69, 0.69],
    ]
    const atBoot = 0.3
    const atDesk = 3.6
    const atWake = atDesk + 0.5
    const atPick = atDesk + 2.6
    const atZoom = atDesk + 3.4
    const atShow = atDesk + 4.2
    const atType = atDesk + 4.8
    const atRest = atType + flat.length / cps + 1

    const rows: number[][] = [
      Array(12).fill(1),
      Array(11).fill(1),
      Array(10).fill(1),
      [1.4, 6, 1.4],
    ]
    const spans = rows.map((r) => r.reduce((a, b) => a + b, 0))

    type MacHost = HTMLDivElement & { stopMac?: () => void }
    const mac = host as MacHost
    mac.stopMac?.()

    const start = () => {
      host.classList.add('visible')

      const cvs = document.createElement('canvas')
      cvs.style.cssText = 'width:100%;height:100%;display:block'
      host.appendChild(cvs)
      const ctx = cvs.getContext('2d')
      if (!ctx) return () => undefined

      let W = 0
      let H = 0
      const dpr = Math.min(devicePixelRatio, 2)
      const resize = () => {
        const b = host.getBoundingClientRect()
        W = b.width
        H = b.height
        cvs.width = W * dpr
        cvs.height = H * dpr
        ctx.setTransform(dpr, 0, 0, dpr, 0, 0)
      }
      resize()

      let t = 0
      let tx = 0
      let ty = 0
      let mx = 0
      let my = 0
      let nextGlitch = 16
      let gl = 0
      let raf = 0
      let live = true
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches
      const compact = window.matchMedia('(max-width: 800px)')

      const wash = (x1: number, a0: number, a1: number) => {
        const g = ctx.createLinearGradient(0, 0, x1, 0)
        g.addColorStop(0, ink(a0))
        g.addColorStop(1, ink(a1))
        return g
      }

      const onMove = (e: PointerEvent) => {
        tx = (e.clientX / innerWidth - 0.5) * 2
        ty = (e.clientY / innerHeight - 0.5) * 2
      }

      const paint = () => {
        if (!W) {
          resize()
          return
        }
        if (!reduce) {
          t += 0.016
          mx += (tx - mx) * 0.05
          my += (ty - my) * 0.05
          if (t > nextGlitch) {
            nextGlitch = t + 20 + Math.random() * 16
            gl = 1
          }
          if (gl > 0) gl -= 0.03
        }

        ctx.clearRect(0, 0, W, H)

        const mobile = compact.matches
        const u = mobile
          ? Math.min(Math.max(160, W * 0.54), 225, (H * 0.94) / 1.45)
          : Math.min(Math.max(275, W * 0.29), 400, (H * 0.6) / 1.45)
        const gw = u * 1.08
        const gh = u * 1.45
        const ox = mobile
          ? (W - gw) / 2 + u * 0.02 + mx * 4
          : W -
            gw -
            Math.max(96, W * 0.1) +
            u * 0.02 +
            mx * 12 +
            (gl > 0 ? (Math.random() - 0.5) * 6 : 0)
        const oy = (H - gh) / 2 + my * (mobile ? 3 : 12) + Math.sin(t * 0.22) * (mobile ? 2 : 5)
        ctx.save()
        ctx.translate(ox, oy)

        const fadeX = gw * (mobile ? 0.35 : 0.95)
        const line = wash(fadeX, mobile ? 0.26 : 0.03, 0.66)
        const faint = wash(fadeX, mobile ? 0.1 : 0.01, 0.26)
        const shade = wash(fadeX, mobile ? 0.03 : 0, 0.07)
        const heavy = mobile ? 1.2 : 2
        const thin = mobile ? 0.9 : 1.3
        const bodyH = u * 1.06
        ctx.lineJoin = 'round'
        ctx.lineCap = 'round'
        ctx.textBaseline = 'middle'

        ctx.beginPath()
        ctx.roundRect(0, 0, u, bodyH, u * 0.07)
        ctx.fillStyle = wash(fadeX, mobile ? 0.02 : 0, 0.05)
        ctx.fill()
        ctx.strokeStyle = line
        ctx.lineWidth = heavy
        ctx.stroke()

        ctx.beginPath()
        ctx.roundRect(u * 0.025, u * 0.022, u * 0.95, bodyH - u * 0.044, u * 0.05)
        ctx.strokeStyle = faint
        ctx.lineWidth = thin
        ctx.stroke()

        ctx.beginPath()
        ctx.roundRect(u * 0.105, u * 0.085, u * 0.79, u * 0.585, u * 0.05)
        ctx.fillStyle = shade
        ctx.fill()
        ctx.stroke()

        const sx = u * 0.137
        const sy = u * 0.117
        const sw = u * 0.726
        const sh = u * 0.521

        ctx.save()
        ctx.beginPath()
        ctx.roundRect(sx, sy, sw, sh, u * 0.028)
        ctx.clip()
        ctx.fillStyle = wash(fadeX, mobile ? 0.05 : 0.01, 0.1)
        ctx.fillRect(sx, sy, sw, sh)

        const p = reduce ? atRest : t
        const seg = (a: number, b: number) => {
          const x = Math.max(0, Math.min(1, (p - a) / (b - a)))
          return x * x * (3 - 2 * x)
        }
        const face = wash(fadeX, mobile ? 0.38 : 0.2, 0.86)
        const mb = Math.max(8, sh * 0.085)
        const ui = Math.max(5, mb * 0.6)

        const iw = Math.min(sw * 0.1, sh * 0.13)
        const icx = sx + sw - sw * 0.1
        const icy = sy + mb + sh * 0.09
        const gap = iw + ui * 2.2
        ctx.font = `${ui}px ${mono}`

        if (p < atDesk && p >= atBoot) {
          const bw = Math.min(sw * 0.26, sh * 0.34)
          const bx = sx + (sw - bw) / 2
          const by = sy + sh * 0.24
          const bh = bw * 1.18
          ctx.strokeStyle = face
          ctx.fillStyle = face
          ctx.lineWidth = mobile ? 1 : 1.3
          ctx.beginPath()
          ctx.roundRect(bx, by, bw, bh, bw * 0.12)
          ctx.roundRect(bx + bw * 0.14, by + bw * 0.14, bw * 0.72, bw * 0.62, bw * 0.06)
          ctx.stroke()
          ctx.beginPath()
          for (const e of [0.36, 0.64]) {
            ctx.moveTo(bx + bw * e + bw * 0.05, by + bw * 0.36)
            ctx.arc(bx + bw * e, by + bw * 0.36, bw * 0.05, 0, Math.PI * 2)
          }
          ctx.fill()
          ctx.beginPath()
          ctx.arc(bx + bw * 0.5, by + bw * 0.44, bw * 0.16, 0.25 * Math.PI, 0.75 * Math.PI)
          ctx.stroke()
          ctx.fillRect(bx + bw * 0.32, by + bh - bw * 0.26, bw * 0.36, bw * 0.06)

          const cap = 'WELCOME'
          ctx.fillText(cap, sx + (sw - ctx.measureText(cap).width) / 2, by + bh + ui * 1.5)
          const barW = sw * 0.42
          const barX = sx + (sw - barW) / 2
          const barY = by + bh + ui * 2.8
          ctx.strokeRect(barX, barY, barW, ui * 0.75)
          ctx.fillRect(barX, barY, barW * seg(atBoot + 0.2, atDesk - 0.2), ui * 0.75)
        }

        if (p >= atDesk) {
          ctx.fillStyle = glass(0.45)
          ctx.fillRect(sx, sy, sw, mb)
          ctx.strokeStyle = ink(0.32)
          ctx.lineWidth = 1
          ctx.beginPath()
          ctx.moveTo(sx, sy + mb)
          ctx.lineTo(sx + sw, sy + mb)
          ctx.stroke()
          ctx.fillStyle = face
          ctx.beginPath()
          ctx.arc(sx + mb * 0.6, sy + mb * 0.48, mb * 0.19, 0, Math.PI * 2)
          ctx.fill()
          ctx.fillText('File  Edit  View', sx + mb * 1.15, sy + mb * 0.54)

          for (const [i, name] of desk.entries()) {
            const x = icx - iw / 2
            const y = icy + i * gap
            const on = i === 1 && p >= atPick && !(p >= atPick + 0.14 && p < atPick + 0.26)
            ctx.strokeStyle = face
            ctx.fillStyle = face
            ctx.lineWidth = 1
            ctx.beginPath()
            if (i === 0) {
              ctx.moveTo(x, y)
              ctx.lineTo(x + iw * 0.44, y)
              ctx.lineTo(x + iw * 0.54, y + iw * 0.2)
              ctx.lineTo(x + iw, y + iw * 0.2)
              ctx.lineTo(x + iw, y + iw * 0.82)
              ctx.lineTo(x, y + iw * 0.82)
              ctx.closePath()
            } else if (i === 1) {
              ctx.rect(x, y, iw, iw * 0.82)
              ctx.moveTo(x, y + iw * 0.22)
              ctx.lineTo(x + iw, y + iw * 0.22)
            } else {
              ctx.arc(x + iw * 0.5, y + iw * 0.5, iw * 0.24, 0, Math.PI * 2)
              for (let k = 0; k < 5; k++) {
                const a = (k / 5) * Math.PI * 2 + 0.4
                const dx = x + iw * 0.5 + Math.cos(a) * iw * 0.4
                const dy = y + iw * 0.5 + Math.sin(a) * iw * 0.4
                ctx.moveTo(dx + iw * 0.06, dy)
                ctx.arc(dx, dy, iw * 0.06, 0, Math.PI * 2)
              }
            }
            if (on) ctx.fill()
            else ctx.stroke()
            if (i === 1 && !on) {
              ctx.fillRect(x + iw * 0.14, y + iw * 0.54, iw * 0.16, iw * 0.14)
            }
            const lw = ctx.measureText(name).width
            const ly = y + iw * 0.82 + ui * 0.9
            if (on) {
              ctx.fillStyle = face
              ctx.fillRect(icx - lw / 2 - ui * 0.25, ly - ui * 0.62, lw + ui * 0.5, ui * 1.2)
              ctx.fillStyle = glass(0.9)
            }
            ctx.fillText(name, icx - lw / 2, ly)
          }
        }

        const wx = sx + sw * 0.05
        const wy = sy + mb + sh * 0.06
        const ww = sw * 0.74
        const wh = sy + sh - wy - sh * 0.06
        const tb = Math.max(7, sh * 0.062)

        if (p >= atZoom && p < atShow) {
          const k = (p - atZoom) / (atShow - atZoom)
          ctx.strokeStyle = ink(0.45)
          ctx.lineWidth = 1
          for (const f of [k * 0.5, k * 0.78, k]) {
            ctx.strokeRect(
              lerp(icx - iw / 2, wx, f),
              lerp(icy + gap, wy, f),
              lerp(iw, ww, f),
              lerp(iw * 0.82, wh, f),
            )
          }
        }

        if (p >= atShow) {
          ctx.fillStyle = glass(0.62)
          ctx.fillRect(wx, wy, ww, wh)
          ctx.strokeStyle = face
          ctx.lineWidth = mobile ? 1 : 1.3
          ctx.strokeRect(wx, wy, ww, wh)
          ctx.beginPath()
          ctx.moveTo(wx, wy + tb)
          ctx.lineTo(wx + ww, wy + tb)
          ctx.stroke()
          ctx.strokeStyle = ink(0.4)
          ctx.lineWidth = 1
          ctx.beginPath()
          for (let k = 1; k < 5; k++) {
            const y = wy + (tb * k) / 5
            ctx.moveTo(wx + tb * 1.2, y)
            ctx.lineTo(wx + ww - tb * 0.4, y)
          }
          ctx.stroke()
          ctx.strokeRect(wx + tb * 0.3, wy + tb * 0.3, tb * 0.42, tb * 0.42)
          const title = 'Terminal'
          const tw = ctx.measureText(title).width
          ctx.fillStyle = glass(0.85)
          ctx.fillRect(wx + (ww - tw) / 2 - ui * 0.4, wy + tb * 0.1, tw + ui * 0.8, tb * 0.8)
          ctx.fillStyle = face
          ctx.fillText(title, wx + (ww - tw) / 2, wy + tb * 0.52)

          const pad = sw * 0.028
          const innerW = ww - pad * 2
          const innerH = wh - tb - pad * 1.6
          ctx.font = `10px ${mono}`
          const adv = ctx.measureText('M'.repeat(cols)).width / 10
          const fs = Math.max(5, Math.min((innerW * 0.98) / adv, innerH / (term.length * 1.5)))
          const lead = fs * 1.5
          ctx.font = `${fs}px ${mono}`
          const ch = ctx.measureText('M').width
          const typed = Math.max(0, Math.min(flat.length, Math.floor((p - atType) * cps)))
          const view = flat.slice(0, typed).split('\n')
          const tail = view[view.length - 1] ?? ''
          const textX = wx + pad
          const textY = wy + tb + pad * 0.8 + fs * 0.9
          const blink = reduce || p % 1.6 < 0.9

          const drawLines = (dx: number, style: string | CanvasGradient, alpha: number) => {
            ctx.globalAlpha = alpha
            ctx.fillStyle = style
            for (const [i, l] of view.entries()) ctx.fillText(l, textX + dx, textY + i * lead)
            if (blink) {
              ctx.fillRect(
                textX + dx + ctx.measureText(tail).width + ch * 0.14,
                textY + (view.length - 1) * lead - fs * 0.46,
                ch * 0.7,
                fs * 0.92,
              )
            }
            ctx.globalAlpha = 1
          }

          drawLines(0, face, 1)
          if (gl > 0) {
            const k = Math.sin(Math.max(0, gl) * Math.PI) * 0.5
            drawLines(-2.5, '#e8712b', k)
            drawLines(2.5, '#5e1a4a', k)
          }
        }

        if (p >= atDesk) {
          const toIcon = seg(atWake, atPick)
          const toPark = seg(atZoom, atShow)
          const px = lerp(lerp(sx + sw * 0.2, icx - iw * 0.14, toIcon), wx + ww * 0.72, toPark)
          const py = lerp(lerp(sy + sh * 0.66, icy + gap + iw * 0.3, toIcon), wy + wh * 0.66, toPark)
          const cs = Math.max(7, sh * 0.09)
          ctx.beginPath()
          for (const [i, [ax, ay]] of arrow.entries()) {
            if (i) ctx.lineTo(px + ax * cs, py + ay * cs)
            else ctx.moveTo(px, py)
          }
          ctx.closePath()
          ctx.fillStyle = face
          ctx.fill()
          ctx.strokeStyle = glass(0.8)
          ctx.lineWidth = 1
          ctx.stroke()
        }

        if (gl > 0) {
          ctx.fillStyle = glass(0.5)
          ctx.fillRect(sx, sy + Math.random() * sh, sw, Math.max(1, sh * 0.03))
        }

        const step = Math.max(2.5, ui * 0.75)
        ctx.fillStyle = ink(0.055)
        for (let y = sy - step + (reduce ? 0 : (t * 6) % step); y < sy + sh; y += step) {
          ctx.fillRect(sx, y, sw, Math.max(0.6, step * 0.3))
        }

        if (!reduce) {
          const band = sy + ((t * 0.11) % 1) * sh
          const g = ctx.createLinearGradient(0, band - sh * 0.22, 0, band)
          g.addColorStop(0, glass(0))
          g.addColorStop(1, glass(0.2))
          ctx.fillStyle = g
          ctx.fillRect(sx, band - sh * 0.22, sw, sh * 0.22)
        }

        const sheen = ctx.createLinearGradient(sx, sy, sx + sw * 0.6, sy + sh * 0.7)
        sheen.addColorStop(0, glass(0.28))
        sheen.addColorStop(0.45, glass(0))
        ctx.fillStyle = sheen
        ctx.fillRect(sx, sy, sw, sh)
        ctx.restore()

        ctx.beginPath()
        ctx.arc(u * 0.855, u * 0.805, u * 0.013, 0, Math.PI * 2)
        ctx.fillStyle = line
        ctx.fill()

        ctx.beginPath()
        ctx.roundRect(u * 0.27, u * 0.78, u * 0.46, u * 0.048, u * 0.02)
        ctx.fillStyle = shade
        ctx.fill()
        ctx.strokeStyle = faint
        ctx.lineWidth = thin
        ctx.stroke()
        ctx.beginPath()
        ctx.moveTo(u * 0.44, u * 0.875)
        ctx.lineTo(u * 0.56, u * 0.875)
        ctx.moveTo(u * 0.07, u * 0.985)
        ctx.lineTo(u * 0.93, u * 0.985)
        ctx.stroke()

        const ky0 = bodyH + u * 0.155
        const ky1 = ky0 + u * 0.2
        ctx.beginPath()
        for (let i = 0; i <= 26; i++) {
          const n = i / 26
          const x = u * 0.5 + Math.sin(n * Math.PI * 3) * u * 0.045
          const y = lerp(bodyH - u * 0.01, ky0, n)
          if (i) ctx.lineTo(x, y)
          else ctx.moveTo(x, y)
        }
        ctx.stroke()

        const edgeL = (v: number) => lerp(u * 0.07, -u * 0.02, v)
        const edgeR = (v: number) => lerp(u * 0.95, u * 1.06, v)
        const kx = (uu: number, v: number) => edgeL(v) + uu * (edgeR(v) - edgeL(v))
        const ky = (v: number) => lerp(ky0, ky1, v)

        ctx.beginPath()
        ctx.moveTo(edgeL(0), ky0)
        ctx.lineTo(edgeR(0), ky0)
        ctx.lineTo(edgeR(1), ky1)
        ctx.lineTo(edgeL(1), ky1)
        ctx.closePath()
        ctx.fillStyle = wash(fadeX, mobile ? 0.02 : 0, 0.05)
        ctx.fill()
        ctx.strokeStyle = line
        ctx.lineWidth = heavy
        ctx.stroke()

        ctx.beginPath()
        ctx.moveTo(edgeL(1), ky1)
        ctx.lineTo(edgeR(1), ky1)
        ctx.lineTo(edgeR(1), ky1 + u * 0.035)
        ctx.lineTo(edgeL(1), ky1 + u * 0.035)
        ctx.closePath()
        ctx.fillStyle = shade
        ctx.fill()
        ctx.strokeStyle = faint
        ctx.lineWidth = thin
        ctx.stroke()

        const rowH = 0.8 / rows.length
        for (const [r, row] of rows.entries()) {
          const v0 = 0.1 + r * rowH + rowH * 0.12
          const v1 = 0.1 + (r + 1) * rowH - rowH * 0.12
          let slot = 0.02
          for (const w of row) {
            const width = (w / spans[r]) * 0.96
            ctx.beginPath()
            ctx.moveTo(kx(slot, v0), ky(v0))
            ctx.lineTo(kx(slot + width - 0.012, v0), ky(v0))
            ctx.lineTo(kx(slot + width - 0.012, v1), ky(v1))
            ctx.lineTo(kx(slot, v1), ky(v1))
            ctx.closePath()
            ctx.stroke()
            slot += width
          }
        }

        ctx.restore()
      }

      const tick = () => {
        if (!live || document.hidden) {
          raf = 0
          return
        }
        paint()
        if (reduce) {
          raf = 0
          return
        }
        raf = requestAnimationFrame(tick)
      }

      const io = new IntersectionObserver(([entry]) => {
        live = entry.isIntersecting
        if (live) tick()
      })
      io.observe(host)

      const onHide = () => {
        if (!document.hidden && live) tick()
      }

      addEventListener('pointermove', onMove)
      addEventListener('resize', resize)
      addEventListener('visibilitychange', onHide)
      document.fonts?.ready.then(() => {
        if (reduce && live) paint()
      })
      tick()

      return () => {
        cancelAnimationFrame(raf)
        raf = 0
        live = false
        io.disconnect()
        removeEventListener('pointermove', onMove)
        removeEventListener('resize', resize)
        removeEventListener('visibilitychange', onHide)
        cvs.remove()
        host.classList.remove('visible')
      }
    }

    mac.stopMac = start()
  }
</script>

<style>
  .mac {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    opacity: 0;
    transition: opacity 1.4s ease;
  }

  .mac.visible {
    opacity: 1;
  }

  @media (max-width: 800px) {
    .mac {
      position: relative;
      inset: auto;
      width: 100%;
      height: 250px;
      margin: 16px 0 10px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .mac {
      transition: none;
    }
  }
</style>
