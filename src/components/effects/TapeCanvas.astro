<div class="tape" data-tape aria-hidden="true"></div>

<script>
  const host = document.querySelector<HTMLDivElement>('[data-tape]')

  if (host) {
    const ink = (a: number) => `rgba(20,18,16,${a})`
    const labels = ['T-120', 'HIGH GRADE', 'HI-FI'] as const
    type TapeHost = HTMLDivElement & { stopTape?: () => void }
    const tape = host as TapeHost
    tape.stopTape?.()

    const start = () => {
      host.classList.add('visible')

      const cvs = document.createElement('canvas')
      cvs.style.cssText = 'width:100%;height:100%;display:block'
      host.appendChild(cvs)
      const ctx = cvs.getContext('2d')
      if (!ctx) return () => undefined

      let W = 0
      let H = 0
      const dpr = Math.min(devicePixelRatio, 2)
      const resize = () => {
        const b = host.getBoundingClientRect()
        W = b.width
        H = b.height
        cvs.width = W * dpr
        cvs.height = H * dpr
        ctx.setTransform(dpr, 0, 0, dpr, 0, 0)
      }
      resize()

      let t = 0
      let wind = 0
      let windT = 0
      let tx = 0
      let ty = 0
      let mx = 0
      let my = 0
      let nextGlitch = 18
      let gl = 0
      let raf = 0
      let live = true
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches
      const compact = window.matchMedia('(max-width: 800px)')

      const wash = (x1: number, a0: number, a1: number) => {
        const g = ctx.createLinearGradient(0, 0, x1, 0)
        g.addColorStop(0, ink(a0))
        g.addColorStop(1, ink(a1))
        return g
      }

      const onMove = (e: PointerEvent) => {
        tx = (e.clientX / innerWidth - 0.5) * 2
        ty = (e.clientY / innerHeight - 0.5) * 2
      }
      const onScroll = () => {
        windT = Math.min(1, scrollY / Math.max(1, innerHeight))
      }
      onScroll()

      const paint = () => {
        if (!W) {
          resize()
          return
        }
        if (!reduce) {
          t += 0.016
          mx += (tx - mx) * 0.05
          my += (ty - my) * 0.05
          wind += (windT - wind) * 0.06
          if (t > nextGlitch) {
            nextGlitch = t + 22 + Math.random() * 18
            gl = 1
          }
          if (gl > 0) gl -= 0.025
        }

        ctx.clearRect(0, 0, W, H)

        const mobile = compact.matches
        const cw = mobile
          ? Math.min(Math.max(260, W * 0.94), 360)
          : Math.min(Math.max(380, W * 0.42), 560)
        const ch = mobile
          ? Math.min(H * 0.94, cw * 0.64)
          : Math.min(H * 0.46, cw * 0.58)
        const ox = mobile
          ? (W - cw) / 2 + mx * 4
          : W - cw - Math.max(96, W * 0.1) + mx * 12 + (gl > 0 ? (Math.random() - 0.5) * 6 : 0)
        const oy = (H - ch) / 2 + my * (mobile ? 3 : 14) + Math.sin(t * 0.22) * (mobile ? 2 : 6)
        ctx.save()
        ctx.translate(ox, oy)

        const fadeX = mobile ? cw * 0.2 : cw * 0.5
        const fade = wash(fadeX, mobile ? 0.28 : 0, 0.72)
        const heavy = mobile ? 1.4 : 2.5
        const thin = mobile ? 1 : 1.5
        ctx.strokeStyle = fade
        ctx.lineWidth = heavy
        ctx.strokeRect(0, 0, cw, ch)
        ctx.lineWidth = thin
        ctx.strokeRect(cw * 0.1, ch * 0.1, cw * 0.86, ch * 0.14)
        ctx.beginPath()
        ctx.moveTo(cw * 0.06, ch * 0.86)
        ctx.lineTo(cw * 0.96, ch * 0.86)
        ctx.stroke()

        ctx.strokeStyle = wash(fadeX, mobile ? 0.12 : 0, 0.34)
        ctx.lineWidth = thin
        ctx.strokeRect(cw * 0.025, ch * 0.05, cw * 0.95, ch * 0.9)
        ctx.fillStyle = wash(fadeX, mobile ? 0.02 : 0, 0.05)
        ctx.fillRect(cw * 0.025, ch * 0.05, cw * 0.95, ch * 0.9)
        ctx.fillStyle = wash(fadeX * 0.8, mobile ? 0.03 : 0, 0.07)
        ctx.fillRect(cw * 0.08, ch * 0.3, cw * 0.84, ch * 0.44)

        ctx.fillStyle = fade
        let size = Math.max(9, ch * 0.048)
        ctx.font = `${size}px "Share Tech Mono", ui-monospace, monospace`
        ctx.textBaseline = 'middle'
        const [t120, grade, hifi] = labels
        const need =
          ctx.measureText(t120).width + ctx.measureText(grade).width + ctx.measureText(hifi).width + 28
        if (need > cw * 0.78) {
          size *= (cw * 0.78) / need
          ctx.font = `${size}px "Share Tech Mono", ui-monospace, monospace`
        }
        ctx.fillText(t120, cw * 0.14, ch * 0.17)
        ctx.fillText(grade, (cw - ctx.measureText(grade).width) / 2, ch * 0.17)
        ctx.fillText(hifi, cw * 0.9 - ctx.measureText(hifi).width, ch * 0.17)

        const reels: [number, number, number][] = [
          [cw * 0.24, ch * 0.5, ch * 0.21],
          [cw * 0.56, ch * 0.5, ch * 0.145],
        ]
        for (const [i, [rx, ry, rr]] of reels.entries()) {
          const spin = reduce ? 0 : (-t * 0.1 - wind * 2.6) * (i ? 1.45 : 1)
          ctx.save()
          ctx.translate(rx, ry)
          ctx.rotate(spin)
          const g = ctx.createRadialGradient(0, 0, rr * 0.22, 0, 0, rr)
          g.addColorStop(0, ink(0.06))
          g.addColorStop(0.42, ink(0.42))
          g.addColorStop(0.92, ink(0.3))
          g.addColorStop(1, ink(0))
          ctx.fillStyle = g
          ctx.beginPath()
          ctx.arc(0, 0, rr, 0, Math.PI * 2)
          ctx.fill()
          ctx.strokeStyle = ink(0.1)
          ctx.lineWidth = 1
          for (let k = 1; k <= 4; k++) {
            ctx.beginPath()
            ctx.arc(0, 0, rr * (0.42 + k * 0.13), 0, Math.PI * 2)
            ctx.stroke()
          }
          ctx.strokeStyle = ink(0.28)
          ctx.lineWidth = 1.2
          for (let k = 0; k < 6; k++) {
            const a = (k / 6) * Math.PI * 2
            ctx.beginPath()
            ctx.moveTo(Math.cos(a) * rr * 0.12, Math.sin(a) * rr * 0.12)
            ctx.lineTo(Math.cos(a) * rr * 0.32, Math.sin(a) * rr * 0.32)
            ctx.stroke()
          }
          ctx.strokeStyle = 'rgba(236,231,220,0.35)'
          ctx.lineWidth = rr * 0.05
          ctx.beginPath()
          ctx.arc(0, 0, rr * 0.3, -0.5, 1.5)
          ctx.stroke()
          ctx.restore()
          if (gl > 0) {
            const k = Math.sin(Math.max(0, gl) * Math.PI) * 0.45
            ctx.globalAlpha = k
            ctx.lineWidth = 2
            ctx.strokeStyle = '#e8712b'
            ctx.beginPath()
            ctx.arc(rx - 4, ry + 1, rr, 0, Math.PI * 2)
            ctx.stroke()
            ctx.strokeStyle = '#5e1a4a'
            ctx.beginPath()
            ctx.arc(rx + 4, ry - 1, rr, 0, Math.PI * 2)
            ctx.stroke()
            ctx.globalAlpha = 1
          }
        }

        ctx.strokeStyle = ink(0.22)
        ctx.lineWidth = mobile ? 1.6 : 2.5
        ctx.lineCap = 'round'
        const sag = 6 + Math.sin(t * 0.5) * 2.5
        for (const s of [-1, 1]) {
          const y0 = reels[0][1] + s * reels[0][2] * 0.94
          const y1 = reels[1][1] + s * reels[1][2] * 0.94
          ctx.beginPath()
          ctx.moveTo(reels[0][0], y0)
          ctx.quadraticCurveTo((reels[0][0] + reels[1][0]) / 2, (y0 + y1) / 2 + s * sag, reels[1][0], y1)
          ctx.stroke()
        }
        ctx.restore()
      }

      const io = new IntersectionObserver(([entry]) => {
        live = entry.isIntersecting
        if (live) tick()
      })
      io.observe(host)

      const tick = () => {
        if (!live || document.hidden) {
          raf = 0
          return
        }
        paint()
        if (reduce) {
          raf = 0
          return
        }
        raf = requestAnimationFrame(tick)
      }

      const onHide = () => {
        if (!document.hidden && live) tick()
      }

      addEventListener('pointermove', onMove)
      addEventListener('scroll', onScroll, { passive: true })
      addEventListener('resize', resize)
      addEventListener('visibilitychange', onHide)
      tick()

      return () => {
        cancelAnimationFrame(raf)
        raf = 0
        live = false
        io.disconnect()
        removeEventListener('pointermove', onMove)
        removeEventListener('scroll', onScroll)
        removeEventListener('resize', resize)
        removeEventListener('visibilitychange', onHide)
        cvs.remove()
        host.classList.remove('visible')
      }
    }

    tape.stopTape = start()
  }
</script>

<style>
  .tape {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    opacity: 0;
    transition: opacity 1.4s ease;
  }

  .tape.visible {
    opacity: 1;
  }

  @media (max-width: 800px) {
    .tape {
      position: relative;
      inset: auto;
      width: 100%;
      height: 200px;
      margin: 16px 0 10px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .tape {
      transition: none;
    }
  }
</style>
