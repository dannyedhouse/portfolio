---
import SectionHead from '../SectionHead.astro'
import TechPills from '../ui/TechPills.astro'
import Interests from '../ui/Interests.astro'
import { aboutProficient, aboutSkills } from '../../data/skills'
import { CAREER_START, yearsSince } from '../../lib/dates'

const experienceYears = yearsSince(CAREER_START)
---

<section id="about" class="sleeve">
  <div class="lead">
    <div class="band">
      <SectionHead title="About" kicker="Nice to meet you" />
    </div>
    <div class="hobby">
      <Interests />
    </div>
  </div>
  <div class="bio">
    <div class="copy">
      <p>
        I'm Danny, a Software Engineer based in London who enjoys bringing engineering and design
        together. I build full-stack products with a focus on usability, accessibility and a keen
        attention to detail.
      </p>
    </div>
    <article class="plate">
      <div class="chroma" aria-hidden="true"></div>
      <dl>
        <div>
          <dt>Position</dt>
          <dd>Senior Software Engineer</dd>
        </div>
        <div>
          <dt>Experience</dt>
          <dd>
            <span data-career-start={CAREER_START}>{experienceYears}+ years</span>
          </dd>
        </div>
        <div>
          <dt>Company</dt>
          <dd>CGI</dd>
        </div>
        <div>
          <dt>Degree</dt>
          <dd>First-Class, Computer Science</dd>
        </div>
      </dl>
      <div class="foot">
        <span>Location</span>
        London, UK
      </div>
    </article>
  </div>
  <div class="meta">
    <div class="label">Stack</div>
    <div class="value">
      <TechPills items={aboutSkills} proficient={aboutProficient} />
    </div>
  </div>
</section>

<style>
  #about {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
    column-gap: clamp(30px, 6vw, 90px);
  }

  .lead {
    display: contents;
  }

  .band {
    grid-column: 1 / -1;
  }

  .bio {
    grid-column: 1;
    grid-row: 2 / 4;
    margin-top: clamp(34px, 6vh, 64px);
    display: flex;
    flex-direction: column;
    gap: 28px;
  }

  .meta {
    grid-column: 2;
    grid-row: 2;
    margin-top: clamp(34px, 6vh, 64px);
    font-size: 13.5px;
    line-height: 1.8;
  }

  .hobby {
    grid-column: 2;
    grid-row: 3;
    margin-top: 26px;
  }

  .copy {
    font-size: 14.5px;
    line-height: 1.95;
    color: var(--copy);
    max-width: 60ch;
  }

  .copy p {
    margin: 0;
  }

  .plate {
    max-width: 36rem;
    overflow: hidden;
    background: color-mix(in srgb, var(--ink) 5%, var(--paper));
    border: 1px solid var(--ink);
    clip-path: polygon(0 0, 100% 0, 100% calc(100% - 16px), calc(100% - 16px) 100%, 0 100%);
  }

  .chroma {
    height: 6px;
    background: linear-gradient(
      90deg,
      var(--dust),
      color-mix(in srgb, var(--ink) 55%, var(--paper)) 42%,
      var(--ink) 58%,
      var(--dust)
    );
  }

  .foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 12px 18px;
    font-size: 11px;
    letter-spacing: var(--track);
    text-transform: uppercase;
    border-top: 1px solid var(--stroke);
    color: var(--copy);
  }

  .foot span {
    color: var(--mg);
  }

  .plate dl {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px 28px;
    margin: 0;
    padding: 18px 18px 16px;
  }

  dt {
    letter-spacing: var(--track);
    color: var(--mg);
    text-transform: uppercase;
    font-size: 11px;
  }

  dd {
    margin: 7px 0 0;
    color: var(--copy);
    font-size: 14px;
    line-height: 1.4;
  }

  .label {
    letter-spacing: var(--track);
    color: var(--mg);
    text-transform: uppercase;
  }

  .value {
    margin-top: 8px;
    color: var(--copy);
  }

  @media (max-width: 800px) {
    #about {
      grid-template-columns: 1fr;
    }

    .lead {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      grid-column: 1;
      grid-row: 1;
      align-items: start;
      column-gap: 8px;
    }

    .band {
      grid-column: 1;
      grid-row: 1;
      min-width: 0;
    }

    .hobby {
      grid-column: 2;
      grid-row: 1;
      justify-self: end;
      align-self: start;
      margin: 0;
      width: clamp(82px, 28vw, 120px);
    }

    .hobby .label {
      display: none;
    }

    .bio {
      grid-column: 1;
      grid-row: 2;
      gap: 20px;
    }

    .meta {
      grid-column: 1;
      grid-row: 3;
    }

    .plate {
      clip-path: polygon(0 0, 100% 0, 100% calc(100% - 10px), calc(100% - 10px) 100%, 0 100%);
    }

    .chroma {
      height: 4px;
    }

    .plate dl {
      gap: 12px 18px;
      padding: 14px 14px 12px;
    }

    dt {
      font-size: 10px;
    }

    dd {
      margin-top: 4px;
      font-size: 13px;
    }

    .foot {
      padding: 10px 14px;
    }
  }
</style>

<script>
  import { yearsSince } from '../../lib/dates'

  const el = document.querySelector<HTMLElement>('[data-career-start]')
  const iso = el?.dataset.careerStart
  if (el && iso) el.textContent = `${yearsSince(iso)}+ years`
</script>
