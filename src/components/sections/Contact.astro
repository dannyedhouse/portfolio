---
import SectionHead from '../SectionHead.astro'
import ActionLink from '../ui/ActionLink.astro'
import { info } from '../../data/info'

const year = new Date().getFullYear()
---

<section id="contact" class="sleeve">
  <SectionHead title="Contact" kicker="No faxes please" />
  <p class="offer">Have a project or opportunity in mind? Say hello!</p>
  <div class="acts">
    <ActionLink variant="site" label="Copy my email" copy={info.email} />
    <ActionLink href={info.github} variant="code" label="GITHUB" mark />
    <ActionLink
      href={info.linkedin}
      variant="code"
      icon="simple-icons:linkedin"
      label="LINKEDIN"
      mark
    />
  </div>
  <noscript>
    <p class="fallback">
      <a href={`mailto:${info.email}`}>{info.email}</a>
    </p>
  </noscript>
  <div class="stop">
    <span>■ STOP · © {year}</span>
    <ActionLink href="#home" variant="code" label="▲ BACK TO TOP" />
  </div>
</section>

<style>
  .offer {
    margin: 22px 0 0;
    max-width: 16ch;
    font-family: var(--display);
    font-size: clamp(22px, 3.4vw, 40px);
    line-height: 1.12;
    letter-spacing: -0.015em;
    color: var(--copy);
  }

  .acts {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: clamp(28px, 5vh, 52px);
  }

  .fallback {
    margin: 12px 0 0;
    font-size: 13px;
  }

  .stop {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    margin: clamp(50px, 9vh, 96px) 0 0;
    padding-top: 18px;
    border-top: 1px solid var(--stroke);
    font-size: 11.5px;
    letter-spacing: var(--track-nav);
    color: var(--mid);
  }

  @media (max-width: 800px) {
    .acts {
      display: grid;
      grid-template-columns: 1fr 1fr;
    }

    .acts :global(.act:first-child) {
      grid-column: 1 / -1;
    }

    .acts :global(.act) {
      width: 100%;
    }
  }
</style>
