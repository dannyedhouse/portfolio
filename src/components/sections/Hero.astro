---
import { Image } from 'astro:assets'
import vhsMark from '../../assets/VHS.webp'
import TapeCanvas from '../effects/TapeCanvas.astro'
---

<section id="home">
  <div class="arrow" aria-hidden="true"></div>
  <h1>
    <span class="hi">Hi there 👋</span>
    <span class="title">I'm a product engineer.</span>
  </h1>
  <p class="ident">Danny Edhouse</p>
  <p class="lede">
    A creative and product-minded full-stack engineer with an eye for design!
  </p>
  <TapeCanvas />
  <div class="foot">
    <div class="badge">
      <Image src={vhsMark} alt="VHS" class="vhs" height={42} densities={[1, 2]} />
      <span class="meta">HQ<br />Supercolor</span>
    </div>
    <a href="#about" class="scroll">SCROLL <span>↓</span></a>
  </div>
</section>

<style>
  #home {
    position: relative;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: clamp(80px, 12vh, 150px) var(--page-inline) clamp(18px, 3vh, 34px)
      var(--page-left);
  }

  .arrow {
    position: absolute;
    top: 50%;
    right: 0;
    transform: translateY(-50%);
    z-index: 1;
    pointer-events: none;
    width: clamp(52px, 7vw, 110px);
    height: clamp(104px, 14vw, 220px);
    background: var(--ink);
    clip-path: polygon(100% 0, 100% 100%, 0 50%);
  }

  h1 {
    position: relative;
    z-index: 1;
    margin: 0;
    max-width: 12ch;
    font-family: var(--display);
    font-size: clamp(38px, min(8.4vw, 11vh), 118px);
    line-height: 0.88;
    letter-spacing: -0.015em;
    text-transform: uppercase;
    animation: jitter 8s steps(1) infinite;
  }

  .hi {
    display: block;
    font-size: 0.52em;
    letter-spacing: 0.01em;
    line-height: 1;
    text-shadow: var(--fringe);
  }

  .title {
    display: block;
    text-shadow: var(--fringe-strong);
  }

  .ident {
    position: relative;
    z-index: 1;
    display: inline-block;
    margin: clamp(22px, 3.4vh, 40px) 0 0;
    font-family: var(--display);
    font-size: clamp(32px, min(5.6vw, 7.2vh), 68px);
    line-height: 0.9;
    letter-spacing: var(--display-track);
    text-transform: uppercase;
    color: var(--mg);
  }

  .lede {
    position: relative;
    z-index: 1;
    margin: clamp(14px, 2.2vh, 22px) 0 0;
    max-width: 34ch;
    font-size: clamp(13px, 1.15vw, 16px);
    line-height: 1.9;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--copy);
  }

  .foot {
    position: relative;
    z-index: 1;
    margin-top: auto;
    padding-top: clamp(18px, 3.2vh, 50px);
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 18px;
    font-size: 12px;
    letter-spacing: var(--track);
    color: var(--mid);
  }

  .badge {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .vhs {
    display: block;
    width: auto;
    height: clamp(24px, 7vw, 42px);
  }

  .meta {
    line-height: 1.6;
    color: var(--mid);
  }

  .scroll {
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--ink);
    animation: bob 2.8s ease-in-out infinite;
  }

  .scroll:hover {
    color: var(--mg);
  }

  @keyframes jitter {
    0%,
    90%,
    100% {
      transform: translate(0, 0);
    }
    92% {
      transform: translate(-2px, 0);
    }
    94% {
      transform: translate(2px, 1px);
    }
    96% {
      transform: translate(-1px, -1px);
    }
  }

  @keyframes bob {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(5px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    h1,
    .scroll {
      animation: none;
    }
  }

  @media (max-width: 600px) {
    .arrow {
      display: none;
    }

    .ident {
      font-size: clamp(26px, 8.4vw, 42px);
    }
  }
</style>
