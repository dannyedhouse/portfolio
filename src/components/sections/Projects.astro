---
import ProjectCard from '../ProjectCard.astro'
import { projects } from '../../data/projects'
---

<section id="projects">
  <div class="head">
    <div>
      <h2>Projects</h2>
      <div class="kicker">Selected work</div>
      <div class="rule"></div>
    </div>
    <div class="tape">TAPE 01<br />SP<br />00:12:36</div>
  </div>
  <div class="list">
    {projects.map((project) => <ProjectCard project={project} />)}
  </div>
</section>

<style>
  #projects {
    position: relative;
    padding: var(--section-y) var(--page-inline) var(--section-y) var(--page-left);
    border-top: 1px solid var(--stroke);
  }

  .head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-start;
    gap: 20px;
  }

  h2 {
    margin: 0;
    font-family: var(--display);
    font-size: clamp(38px, 7vw, 96px);
    line-height: 0.9;
    letter-spacing: var(--display-track);
    text-transform: uppercase;
    text-shadow: var(--fringe);
  }

  .kicker {
    margin-top: 16px;
    font-size: 13px;
    letter-spacing: var(--track);
    text-transform: uppercase;
    color: var(--mid);
  }

  .rule {
    margin-top: 14px;
    width: 34px;
    height: 2px;
    background: var(--ink);
  }

  .tape {
    font-size: 12px;
    letter-spacing: var(--track);
    line-height: 1.9;
    color: var(--mid);
    text-align: right;
  }

  .list {
    margin-top: clamp(40px, 7vh, 80px);
    display: flex;
    flex-direction: column;
    gap: clamp(56px, 10vh, 110px);
  }
</style>
