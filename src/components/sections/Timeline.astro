---
import SectionHead from '../SectionHead.astro'
import TechPills from '../ui/TechPills.astro'
import { timeline } from '../../data/timeline'
---

<section id="timeline" class="sleeve">
  <SectionHead title="Timeline" kicker="My journey so far..." />

  <div class="track" data-track>
    <div class="line" aria-hidden="true">
      <div class="fill"></div>
    </div>
    {timeline.map((chapter) => (
      <article class:list={{ current: chapter.current }} data-chapter>
        <div class="dot" aria-hidden="true"></div>
        <div class="when">
          <div class="year">{chapter.year}</div>
          <div class="span">{chapter.span}</div>
        </div>
        <div class="body">
          <h3>{chapter.title}</h3>
          {chapter.company && <div class="co">{chapter.company}</div>}
          {chapter.lines.map((line) => (
            <p>{line}</p>
          ))}
          <TechPills items={chapter.stack} />
        </div>
      </article>
    ))}
  </div>
</section>

<style>
  .track {
    --rail: clamp(120px, 15vw, 210px);
    position: relative;
    margin-top: clamp(40px, 7vh, 80px);
  }

  .line {
    position: absolute;
    left: var(--rail);
    top: 8px;
    bottom: 8px;
    width: 1px;
    background: var(--hair);
  }

  .fill {
    width: 3px;
    height: 100%;
    margin-left: -1px;
    background: var(--ink);
    transform: scaleY(0);
    transform-origin: top;
  }

  @keyframes rail-fill {
    from {
      transform: scaleY(0);
    }
    to {
      transform: scaleY(1);
    }
  }

  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .fill {
        animation-name: rail-fill;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: view();
        animation-range: cover 50vh cover calc(100% - 50vh);
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .fill {
        transform: scaleY(1);
      }
    }
  }

  article {
    position: relative;
    display: grid;
    grid-template-columns: var(--rail) minmax(0, 1fr);
    gap: clamp(26px, 4vw, 56px);
    min-height: 72vh;
    padding-bottom: clamp(64px, 12vh, 140px);
  }

  article:last-child {
    padding-bottom: 24px;
  }

  .dot {
    position: absolute;
    left: var(--rail);
    top: 10px;
    z-index: 1;
    width: 11px;
    height: 11px;
    border-radius: 50%;
    background: var(--paper);
    box-shadow: 0 0 0 1px var(--ink);
    transform: translateX(-5px);
  }

  article.current .dot {
    background: var(--ink);
  }

  .when {
    position: sticky;
    top: 88px;
    align-self: start;
  }

  .year {
    font-family: var(--display);
    font-size: clamp(28px, 4vw, 48px);
    line-height: 1;
    letter-spacing: var(--display-track);
  }

  .span {
    margin-top: 8px;
    font-size: 12px;
    letter-spacing: var(--track);
    color: var(--mid);
  }

  .body {
    padding-left: clamp(18px, 3vw, 40px);
  }

  h3 {
    margin: 0;
    font-family: var(--display);
    font-size: clamp(17px, 1.9vw, 24px);
    letter-spacing: -0.01em;
    text-transform: uppercase;
    line-height: 1.15;
  }

  .co {
    margin-top: 8px;
    font-size: 15px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--mg);
  }

  p {
    margin: 14px 0 0;
    font-size: 14px;
    line-height: 1.9;
    color: var(--copy);
    max-width: 54ch;
  }

  .body :global(.pills) {
    margin-top: 20px;
  }

  @media (prefers-reduced-motion: no-preference) {
    [data-chapter].wait .body,
    [data-chapter].wait .when {
      opacity: 0;
      transform: translateY(20px);
    }

    [data-chapter].wait.in .body,
    [data-chapter].wait.in .when {
      opacity: 1;
      transform: none;
      transition:
        opacity 0.8s ease,
        transform 0.8s ease;
    }
  }

  @media (max-width: 800px) {
    .track {
      --rail: 6px;
    }

    article {
      grid-template-columns: 1fr;
      gap: 12px;
      min-height: 0;
      padding-bottom: 64px;
    }

    article:last-child {
      padding-bottom: 0;
    }

    .when,
    .body {
      padding-left: 28px;
    }

    .when {
      position: static;
    }
  }
</style>

<script>
  import { onScroll } from '../../lib/scroll'

  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches
  const track = document.querySelector<HTMLElement>('[data-track]')
  const fill = track?.querySelector<HTMLElement>('.fill')
  if (track && fill && !CSS.supports('animation-timeline', 'view()')) {
    if (reduce) {
      fill.style.transform = 'scaleY(1)'
    } else {
      onScroll(() => {
        const r = track.getBoundingClientRect()
        const p = Math.max(0, Math.min(1, (innerHeight * 0.5 - r.top) / r.height))
        fill.style.transform = `scaleY(${p})`
      })
    }
  }
</script>
