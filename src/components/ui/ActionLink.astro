---
import { Icon } from 'astro-icon/components'

interface Props {
  href: string
  variant?: 'site' | 'code'
  label: string
}

const { href, variant = 'site', label } = Astro.props
const icon = variant === 'code' ? 'simple-icons:github' : undefined
---

<a href={href} target="_blank" rel="noreferrer" class:list={['act', variant]}>
  {icon && <Icon name={icon} size={14} aria-hidden="true" />}
  {label}
</a>

<style>
  .act {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 11px 18px;
    font-size: 12px;
    letter-spacing: var(--track-nav);
  }

  .act :global(svg),
  .act :global(path) {
    width: 14px;
    height: 14px;
    flex-shrink: 0;
    fill: currentColor;
  }

  .site {
    background: var(--ink);
    color: var(--paper);
  }

  .site:hover {
    background: var(--mg);
    color: var(--paper);
  }

  .code {
    background: transparent;
    color: var(--ink);
    box-shadow: inset 0 0 0 1px var(--ink);
  }

  .code:hover {
    background: var(--ink);
    color: var(--paper);
  }
</style>
