---
import { Icon } from 'astro-icon/components'

interface Props {
  href?: string
  variant?: 'site' | 'code'
  label: string
  icon?: string
  copy?: string
  mark?: boolean
}

const { href, variant = 'site', label, icon, copy, mark } = Astro.props
const external = !!href && /^https?:/.test(href)
const iconName = copy
  ? undefined
  : (icon ?? (variant === 'code' && external ? 'simple-icons:github' : undefined))
---

{
  copy ? (
    <button type="button" class:list={['act', variant]} data-copy={copy}>
      {label}
    </button>
  ) : (
    <a
      href={href}
      class:list={['act', variant]}
      target={external ? '_blank' : undefined}
      rel={external ? 'noreferrer' : undefined}
    >
      {iconName && <Icon name={iconName} size={14} aria-hidden="true" />}
      {label}
      {mark && (
        <span class="mark" aria-hidden="true">
          ↗
        </span>
      )}
    </a>
  )
}

<style>
  .act {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    padding: 11px 18px;
    font: inherit;
    font-size: 12px;
    letter-spacing: var(--track-nav);
    cursor: pointer;
    border: 0;
  }

  .act :global(svg),
  .act :global(path) {
    width: 14px;
    height: 14px;
    flex-shrink: 0;
    fill: currentColor;
  }

  .mark {
    font-size: 11px;
    line-height: 1;
  }

  .site {
    background: var(--ink);
    color: var(--paper);
  }

  .site:hover {
    background: var(--mg);
    color: var(--paper);
  }

  .code {
    background: transparent;
    color: var(--ink);
    box-shadow: inset 0 0 0 1px var(--ink);
  }

  .code:hover {
    background: var(--ink);
    color: var(--paper);
  }
</style>

<script>
  for (const el of document.querySelectorAll<HTMLElement>('[data-copy]')) {
    if (el.dataset.copyBound) continue
    el.dataset.copyBound = ''
    el.addEventListener('click', async () => {
      const value = el.dataset.copy
      if (!value || !navigator.clipboard) return
      try {
        await navigator.clipboard.writeText(value)
      } catch {
        return
      }
      const label = el.dataset.copyLabel ?? el.textContent?.trim() ?? ''
      el.dataset.copyLabel = label
      el.textContent = 'Copied'
      setTimeout(() => {
        el.textContent = label
      }, 1600)
    })
  }
</script>
