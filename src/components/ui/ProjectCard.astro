---
import { Picture } from 'astro:assets'
import type { Project } from '../../data/projects'
import ActionLink from './ActionLink.astro'
import TechPills from './TechPills.astro'

interface Props {
  project: Project
}

const { project } = Astro.props
const { index, kind, title, blurb, stack, href, code, flip = false, image } = project
const codeHref = typeof code === 'string' ? code : undefined
---

<article class:list={{ flip }} data-project>
  <div class="stage">
    <div class="crt">
      <div class="bezel">
        <div class:list={['glass', { shot: image }]}>
          {image ? (
            <Picture
              src={image}
              formats={['avif', 'webp']}
              fallbackFormat="webp"
              widths={[720, 1100, 1440]}
              sizes="(max-width: 800px) calc(100vw - 52px), min(46vw, 640px)"
              alt={title}
              quality={85}
              pictureAttributes={{ class: 'frame' }}
              class="frame-img"
            />
          ) : (
            <span>Image</span>
          )}
        </div>
        <div class="chin" aria-hidden="true">
          <span class="drive"></span>
          <span class="btn"></span>
        </div>
      </div>
    </div>
  </div>
  <div class="copy">
    <div class="idx">{index} · {kind}</div>
    <h3>{title}</h3>
    {blurb && <p>{blurb}</p>}
    <TechPills items={stack} />
    {(href || code) && (
      <div class="acts">
        {href && <ActionLink href={href} variant="site" label="VISIT SITE ▶" />}
        {code && <ActionLink href={codeHref} variant="code" label="VIEW CODE" />}
      </div>
    )}
  </div>
</article>

<style>
  article {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr);
    gap: clamp(36px, 5.5vw, 84px);
    align-items: center;
  }

  article.flip {
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
  }

  article.flip .stage {
    order: 2;
  }

  article.flip .copy {
    order: 1;
  }

  .stage {
    width: 100%;
  }

  .bezel {
    padding: 5px 5px 0;
    border-radius: 22px;
    background: var(--paper);
    box-shadow: 0 0 0 1px color-mix(in srgb, var(--ink) 12%, transparent);
  }

  .glass {
    overflow: hidden;
    border-radius: 18px;
    background: color-mix(in srgb, var(--ink) 4%, var(--paper));
  }

  .glass:not(.shot) {
    aspect-ratio: 2 / 1;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .glass span {
    font-size: 11px;
    letter-spacing: var(--track);
    text-transform: uppercase;
    color: var(--grey);
  }

  .chin {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 10px 4px 10px;
  }

  .drive {
    width: 26%;
    height: 4px;
    border-radius: 1px;
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--ink) 18%, transparent);
  }

  .btn {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    box-shadow: 0 0 0 1px color-mix(in srgb, var(--ink) 22%, transparent);
  }

  .frame,
  .frame-img {
    width: 100%;
    height: auto;
    display: block;
  }

  .frame-img {
    object-fit: contain;
    object-position: center;
  }

  .idx {
    font-size: 12px;
    letter-spacing: 0.2em;
    color: var(--mid);
  }

  h3 {
    margin: 10px 0 14px;
    font-family: var(--display);
    font-size: clamp(22px, 2.7vw, 34px);
    letter-spacing: -0.01em;
    text-transform: uppercase;
    line-height: 1.04;
  }

  p {
    margin: 0 0 22px;
    font-size: 14px;
    line-height: 1.9;
    color: var(--copy);
    max-width: 46ch;
  }

  .acts {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 26px;
  }

  @media (prefers-reduced-motion: no-preference) {
    [data-project].wait .crt {
      opacity: 0;
      transform: translateY(28px);
    }

    [data-project].wait.in .crt {
      opacity: 1;
      transform: none;
      transition:
        opacity 0.9s ease,
        transform 0.9s ease;
    }
  }

  @media (max-width: 800px) {
    article,
    article.flip {
      grid-template-columns: 1fr;
    }

    article.flip .stage,
    article.flip .copy {
      order: 0;
    }

    article:not(:first-child) {
      border-top: 1px solid var(--hair);
      padding-top: 44px;
      margin-top: 44px;
    }

    .stage {
      width: 100%;
    }

    .chin {
      padding: 7px 4px 8px;
    }
  }
</style>

<script>
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches
  if (!reduce) {
    const cards = document.querySelectorAll<HTMLElement>('[data-project]')
    for (const el of cards) {
      const io = new IntersectionObserver(
        ([entry]) => {
          if (entry.isIntersecting) {
            el.classList.add('in')
            io.disconnect()
          } else {
            el.classList.add('wait')
          }
        },
        { threshold: 0.16, rootMargin: '0px 0px -12% 0px' },
      )
      io.observe(el)
    }
  }
</script>
