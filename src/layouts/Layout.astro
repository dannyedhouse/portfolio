---
import archivoBlack from '../fonts/archivo-black.woff2?url';
import shareTechMono from '../fonts/share-tech-mono.woff2?url';
import '../styles/tokens.css';
import '../styles/globals.css';
import Grain from '../components/effects/Grain.astro';
import ColorRail from '../components/effects/ColorRail.astro';
import Nav from '../components/Nav.astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Danny Edhouse',
  description = 'Portion website',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preload" href={shareTechMono} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={archivoBlack} as="font" type="font/woff2" crossorigin />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body>
    <Grain />
    <ColorRail />
    <Nav />
    <slot />
  </body>
</html>
