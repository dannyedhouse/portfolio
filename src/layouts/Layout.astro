---
import archivoBlack from '../fonts/archivo-black.woff2?url'
import shareTechMono from '../fonts/share-tech-mono.woff2?url'
import '../styles/tokens.css'
import '../styles/globals.css'
import Grain from '../components/effects/Grain.astro'
import ColorRail from '../components/effects/ColorRail.astro'
import Nav from '../components/Nav.astro'

const title = 'Danny Edhouse - Software Engineer'
const description = 'A creative and product-minded full-stack engineer with an eye for design!'
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preload" href={shareTechMono} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={archivoBlack} as="font" type="font/woff2" crossorigin />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Grain />
    <ColorRail />
    <Nav />
    <main id="main">
      <slot />
    </main>
  </body>
</html>
